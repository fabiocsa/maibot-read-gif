{
  "manifest_version": 2,
  "id": "github.fabiocsa.read-gif",
  "version": "0.1.2",
  "name": "GIF 动图识别（Read GIF）",
  "description": "检测聊天里的 GIF / 动态 WebP / APNG，抽取多帧拼成带时间标注的帧板，调用宿主视觉模型生成动图描述并注入消息，让麦麦真正看懂动图。",
  "author": {
    "name": "fabiocsa",
    "url": "https://github.com/fabiocsa"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/fabiocsa/maibot-read-gif",
    "homepage": "https://github.com/fabiocsa/maibot-read-gif",
    "documentation": "https://github.com/fabiocsa/maibot-read-gif/blob/main/README.md",
    "issues": "https://github.com/fabiocsa/maibot-read-gif/issues"
  },
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "999.999.999"
  },
  "plugin_type": "media",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "film",
      "fallback": "images"
    }
  },
  "changelog": "CHANGELOG.md",
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
