{
  "manifest_version": 2,
  "id": "github.fabiocsa.read-animation",
  "version": "0.1.0",
  "name": "动图帧识别（Read Animation）",
  "description": "检测聊天里的 GIF/WebP/APNG，抽取多帧拼成带时间标注的帧板，调用宿主视觉模型生成动图描述并注入消息，让麦麦真正看懂动图。",
  "author": {
    "name": "fabiocsa",
    "url": "https://github.com/fabiocsa"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/fabiocsa/maibot-read-animation",
    "homepage": "https://github.com/fabiocsa/maibot-read-animation",
    "documentation": "https://github.com/fabiocsa/maibot-read-animation/blob/main/README.md",
    "issues": "https://github.com/fabiocsa/maibot-read-animation/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
